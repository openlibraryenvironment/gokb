{
  "settings": {
    "number_of_shards": 1,
    "analysis": {
      "char_filter": {
        "colon_filter": {
          "type": "pattern_replace",
          "pattern": ":",
          "replacement": " "
        },
        "url_protocol_filter": {
          "type": "pattern_replace",
          "pattern": "https?://",
          "replacement": ""
        }
      },
      "filter": {
        "autocomplete_filter": {
          "type":     "edge_ngram",
          "min_gram": 1,
          "max_gram": 20
        },
        "truncate_30": {
          "type": "truncate",
          "length": 30
        }
      },
      "analyzer": {
        "autocomplete": {
          "type":      "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "autocomplete_filter"
          ]
        },
        "custom_chars_analyzer": {
          "type":      "custom",
          "tokenizer": "standard",
          "char_filter": [
            "colon_filter"
          ],
          "filter": [
            "lowercase"
          ]
        },
        "url": {
          "type":      "custom",
          "tokenizer": "url_tokenizer",
          "char_filter": [
            "url_protocol_filter"
          ],
          "filter": [
            "lowercase"
          ]
        },
        "url_search": {
          "type":      "custom",
          "tokenizer": "url_tokenizer",
          "filter": [
            "lowercase",
            "truncate_30"
          ]
        },
        "icu": {
          "type": "custom",
          "tokenizer": "icu_tokenizer",
          "char_filter": [
            "colon_filter"
          ],
          "filter": [
            "lowercase",
            "icu_folding"
          ]
        },
        "icu_suggest": {
          "type":      "custom",
          "tokenizer": "icu_tokenizer",
          "filter": [
            "lowercase",
            "icu_folding",
            "autocomplete_filter"
          ]
        }
      },
      "tokenizer": {
        "url_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 3,
          "max_gram": 30,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      }
    }
  }
}
